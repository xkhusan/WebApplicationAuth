#@WebApplication_HostAddress = http://localhost:5001
@WebApplication_HostAddress = https://localhost:7270

### Register User
POST {{WebApplication_HostAddress}}/api/authentication/register-user
Content-Type: application/json
{
  "firstName": "Khusan",
  "lastName": "Rashidov",
  "emailAddress": "xkhusan@gmail.com",
  "userName": "xkhusan",
  "passWord": "KateK8Kane*"
}

### Login User
# @name login
POST {{WebApplication_HostAddress}}/api/authentication/login-user
Content-Type: application/json
{
  "emailAddress": "xkhusan@gmail.com",
  "passWord": "KateK8Kane*"
}

### Refresh Token
# @name refresh
POST {{WebApplication_HostAddress}}/api/authentication/refresh-token
Content-Type: application/json
{
  "accessToken": "{{login.response.body.$.accessToken}}",
  "refreshToken": "{{login.response.body.$.refreshToken}}"
}

### Get Home Index with AccessToken
GET {{WebApplication_HostAddress}}/api/home
Authorization: Bearer {{login.response.body.$.accessToken}}

### Get Home Index with RefreshToken
GET {{WebApplication_HostAddress}}/api/home
Authorization: Bearer {{refresh.response.body.$.accessToken}}

### Refresh Token
POST {{WebApplication_HostAddress}}/api/authentication/refresh-token
Content-Type: application/json
{
  "accessToken": "{{refresh.response.body.$.accessToken}}",
  "refreshToken": "{{refresh.response.body.$.refreshToken}}"
}